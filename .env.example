# 运行前请复制为 .env，并替换所有示例值。
# 生成随机路径：python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=REPLACE_WITH_A_RANDOM_URL_SAFE_STRING_AT_LEAST_43_CHARS

# 你的公开域名，不要带 https:// 或路径。
MCP_PUBLIC_HOST=reader.example.com
MCP_BIND_HOST=localhost
MCP_PORT=18120

# 多项用英文逗号分隔。
MCP_ALLOWED_HOSTS=reader.example.com,localhost:18120
MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com,https://reader.example.com

# 只有 transcribe=true 时需要。留空则仍可读取元数据、图片和视频帧。
SILICONFLOW_API_KEY=
LOG_LEVEL=warning

# 概要模式需要百炼北京地域 key；模型和接口可按地域修改。
OMNI_API_KEY=
OMNI_MODEL=qwen3-omni-flash
OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 与示例 systemd 的 StateDirectory 对应。手动启动时改为可写目录。
OMNI_CACHE_DIR=/var/lib/xhs-douyin-reader-mcp/watch-cache
